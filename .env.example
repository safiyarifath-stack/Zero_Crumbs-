# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APPS_SCRIPT_EMAIL_URL: Free Google Apps Script MailApp Web App URL for Email OTP & reminders.
APPS_SCRIPT_EMAIL_URL=

# APPS_SCRIPT_EMAIL_SECRET: Shared secret token verified by your Google Apps Script Web App.
APPS_SCRIPT_EMAIL_SECRET=

# RESEND_API_KEY: Optional API key for sending real email OTP / expiry reminders via Resend.
RESEND_API_KEY=

# REMINDER_FROM_EMAIL: Verified sender email address used when RESEND_API_KEY is configured.
REMINDER_FROM_EMAIL=

# Google Maps Platform API key (injected via AI Studio Secrets or environment)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

